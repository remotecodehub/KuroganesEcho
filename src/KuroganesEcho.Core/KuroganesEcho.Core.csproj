<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="KuroganesEcho.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MonoGame.Extended" Version="6.1.1" />
  </ItemGroup>
  <Target Name="AddSupportedCultureMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <_LocalizedResxFiles Include="Localization\Resources.*.resx" />
      <AssemblyMetadata Include="SupportedCulture" Value="$([System.String]::Copy('%(_LocalizedResxFiles.Filename)').Substring(10))" Condition="'%(_LocalizedResxFiles.Filename)' != ''" />
    </ItemGroup>
  </Target>
</Project>
